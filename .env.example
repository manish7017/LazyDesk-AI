# LazyDesk AI Configuration
# Server Port & Host (Default is loopback for local security)
PORT=3001
HOST=127.0.0.1

# Ollama Local Service Configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=llama3.2

# File Organization Engine Defaults
MAX_FILE_SIZE_MB=50
MAX_CONTENT_SAMPLE_CHARS=3000
CONFIDENCE_THRESHOLD=0.75

# SQLite Database Path
DATABASE_PATH=./lazydesk.sqlite
